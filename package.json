{
  "name": "c-script-localhost-panel",
  "productName": "C-Script LocalHost Panel",
  "version": "1.1.5",
  "description": "C-Script LocalHost Panel — local PHP & MySQL development environment",
  "repository": {
    "type": "git",
    "url": "https://github.com/CHAMI-csr/c-script-localhost-panel.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.cscript.localhostpanel",
    "productName": "C-Script LocalHost Panel",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "CHAMI-csr",
      "repo": "c-script-localhost-panel",
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": "resources/bundled",
        "to": "bundled",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**/*",
      "renderer/**/*",
      "src/**/*"
    ]
  },
  "keywords": [
    "electron",
    "php",
    "mysql",
    "local",
    "development",
    "c-script"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "mysql2": "^3.24.4"
  }
}
